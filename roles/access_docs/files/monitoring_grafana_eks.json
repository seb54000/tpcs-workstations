    {
      "id": 15,
      "title": "RAM par instance — moyenne glissante 5 min",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Working set mémoire du nœud (OS et pods), relevé chaque minute via kubelet. % de la capacité physique, hors cache récupérable. Moyenne des échantillons disponibles sur 5 minutes ; aucune interpolation avant le début de collecte.",
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "avg_over_time((aws_eks_node_memory_percent{region=~\"$region\",cluster=~\"$cluster\"} and (time() - aws_eks_node_memory_timestamp_seconds{region=~\"$region\",cluster=~\"$cluster\"} < 120))[5m:1m]) and (time() - aws_eks_node_memory_timestamp_seconds{region=~\"$region\",cluster=~\"$cluster\"} < 120)",
          "instant": false,
          "format": "time_series",
          "legendFormat": "{{cluster}} / {{instance_id}}"
        }
