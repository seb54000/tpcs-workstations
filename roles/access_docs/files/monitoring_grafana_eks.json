{
  "uid": "tpcs-eks-overview",
  "title": "AWS EKS — Vue globale TP",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "AWS",
    "EKS",
    "TP"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        }
      },
      {
        "name": "region",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(aws_eks_collection_timestamp_seconds, region)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(aws_eks_cluster_info{region=~\"$region\"}, cluster)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Collecte AWS réussie (1 = oui)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "0 = erreur AWS ; vérifier les droits et les logs cron. Une erreur ne signifie pas zéro cluster.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aws_eks_collection_success{region=~\"$region\"}",
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{region}} / {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showHeader": true
      }
    },
    {
      "id": 2,
      "title": "Âge de la collecte",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Doit rester inférieur à 10 minutes. Une valeur élevée indique un cron arrêté.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - aws_eks_collection_timestamp_seconds{region=~\"$region\"}",
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{region}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showHeader": true
      }
    },
    {
      "id": 3,
      "title": "Clusters dans les régions sélectionnées",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Le filtre cluster ne s’applique pas à ce total régional. 0 = aucun cluster ; N/A = collecte indisponible.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(aws_eks_clusters{region=~\"$region\"})",
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{cluster}} / {{nodegroup}} / {{instance_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showHeader": true
      }
    },
    {
      "id": 4,
      "title": "Groupes de nœuds des clusters sélectionnés",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(aws_eks_nodegroups{region=~\"$region\",cluster=~\"$cluster\"})",
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{cluster}} / {{nodegroup}} / {{instance_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showHeader": true
      }
    },
    {
      "id": 5,
      "title": "Clusters : état AWS et version",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aws_eks_cluster_info{region=~\"$region\",cluster=~\"$cluster\"}",
          "instant": true,
          "format": "table",
          "legendFormat": "{{cluster}} / {{nodegroup}} / {{instance_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showHeader": true
      }
    },
    {
      "id": 6,
      "title": "Groupes : état AWS",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aws_eks_nodegroup_info{region=~\"$region\",cluster=~\"$cluster\"}",
          "instant": true,
          "format": "table",
          "legendFormat": "{{cluster}} / {{nodegroup}} / {{instance_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showHeader": true
      }
    },
    {
      "id": 7,
      "title": "Problèmes de santé des clusters",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aws_eks_cluster_health_issues{region=~\"$region\",cluster=~\"$cluster\"}",
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{cluster}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showHeader": true
      }
    },
    {
      "id": 8,
      "title": "Problèmes de santé des groupes",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aws_eks_nodegroup_health_issues{region=~\"$region\",cluster=~\"$cluster\"}",
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{cluster}} / {{nodegroup}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showHeader": true
      }
    },
    {
      "id": 9,
      "title": "Nœuds présents par groupe (ASG)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Instances présentes dans les Auto Scaling Groups, y compris celles en transition. Ne mesure pas Kubernetes Ready.",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aws_eks_nodegroup_nodes{region=~\"$region\",cluster=~\"$cluster\"}",
          "instant": false,
          "format": "time_series",
          "legendFormat": "{{cluster}} / {{nodegroup}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showHeader": true
      }
    },
    {
      "id": 10,
      "title": "Nœuds souhaités par groupe",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aws_eks_nodegroup_desired_nodes{region=~\"$region\",cluster=~\"$cluster\"}",
          "instant": false,
          "format": "time_series",
          "legendFormat": "{{cluster}} / {{nodegroup}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showHeader": true
      }
    },
    {
      "id": 11,
      "title": "Instances : groupe, cycle de vie et santé ASG",
      "type": "table",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aws_eks_node_info{region=~\"$region\",cluster=~\"$cluster\"}",
          "instant": true,
          "format": "table",
          "legendFormat": "{{cluster}} / {{nodegroup}} / {{instance_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showHeader": true
      }
    },
    {
      "id": 12,
      "title": "CPU par instance (moyenne sur 5 min)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Dernier point CloudWatch disponible de moins de 15 minutes. Absence de point = N/A, pas 0 %.",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aws_eks_node_cpu_percent{region=~\"$region\",cluster=~\"$cluster\"} and (time() - aws_eks_node_cpu_percent_timestamp_seconds{region=~\"$region\",cluster=~\"$cluster\"} < 900)",
          "instant": false,
          "format": "time_series",
          "legendFormat": "{{cluster}} / {{nodegroup}} / {{instance_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showHeader": true
      }
    },
    {
      "id": 13,
      "title": "Échecs des contrôles EC2 (0 = OK)",
      "type": "timeseries",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aws_eks_node_status_check_failed{region=~\"$region\",cluster=~\"$cluster\"} and (time() - aws_eks_node_status_check_failed_timestamp_seconds{region=~\"$region\",cluster=~\"$cluster\"} < 900)",
          "instant": false,
          "format": "time_series",
          "legendFormat": "{{cluster}} / {{nodegroup}} / {{instance_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showHeader": true
      }
    },
    {
      "id": 14,
      "title": "Âge du point CPU CloudWatch",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "",
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - aws_eks_node_cpu_percent_timestamp_seconds{region=~\"$region\",cluster=~\"$cluster\"}",
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{cluster}} / {{nodegroup}} / {{instance_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showHeader": true
      }
    }
  ],
  "description": "Inventaire EKS, santé AWS/ASG/EC2 et CPU CloudWatch. Groupes managés uniquement ; ne mesure pas la santé des pods ni Kubernetes Ready. Collecte toutes les 5 minutes."
}
