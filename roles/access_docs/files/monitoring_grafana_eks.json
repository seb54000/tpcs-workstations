{
  "uid": "tpcs-eks-overview",
  "title": "AWS EKS — Vue globale TP",
  "schemaVersion": 39,
  "version": 2,
  "tags": [
    "AWS",
    "EKS",
    "TP"
  ],
  "timezone": "browser",
  "refresh": "1m",
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": {
          "text": "Prometheus",
          "value": "Prometheus"
        }
      },
      {
        "name": "region",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values(aws_eks_collection_timestamp_seconds, region)",
        "refresh": 1,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      },
      {
        "name": "cluster",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${datasource}"
        },
        "query": "label_values({__name__=~\"aws_eks_cluster_info|aws_eks_resource_info\",region=~\"$region\"}, cluster)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Collecte AWS réussie (1 = oui)",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "0 = erreur AWS ; vérifier les droits et les logs cron. Une erreur ne signifie pas zéro cluster.",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "aws_eks_collection_success{region=~\"$region\"}",
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{region}} / {{stage}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showHeader": true
      }
    },
    {
      "id": 2,
      "title": "Âge de la collecte",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Doit rester inférieur à 10 minutes. Une valeur élevée indique un cron arrêté.",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "time() - aws_eks_collection_timestamp_seconds{region=~\"$region\"}",
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{region}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "noValue": "N/A",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 600
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "showHeader": true
      }
    },
    {
      "id": 3,
      "title": "Clusters dans les régions sélectionnées",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "description": "Le filtre cluster ne s’applique pas à ce total régional. 0 = aucun cluster ; N/A = collecte indisponible.",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(aws_eks_clusters{region=~\"$region\"})",
          "instant": true,
          "format": "time_series",
          "legendFormat": "{{cluster}} / {{nodegroup}} / {{instance_id}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "noValue": "N/A",
          "thresholds": {
